{
  "name": "interception",
  "version": "1.7.0",
  "private": true,
  "type": "module",
  "description": "A calm, private space for habits, mood and writing. Local-first. JavaScript + Android WebView (Capacitor).",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node scripts/test.mjs",
    "android:add": "cap add android && node scripts/android-setup.mjs",
    "android:sync": "npm run build && cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/haptics": "^7.0.0",
    "@capacitor/local-notifications": "^7.0.0",
    "@capacitor/share": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "vite": "^5.4.10"
  },
  "engines": {
    "node": ">=20"
  }
}
